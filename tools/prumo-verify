#!/usr/bin/env bash
# prumo-verify: Bolina mechanical gates (CONTRIBUTING.md section 2)
#
# Prints ALL ELEVEN gate rows on every run. Every gate is enforced; each
# derives its denominator from the source at run time (SPEC, source grep,
# receipt file) rather than from a stored copy.
#
# Conventions enforced here:
#   M1: SPEC.md declares BE-* items as paragraph-opening bold markers:
#        **BE-<CLASS>-<NN>** ... The canonical list is derived from SPEC.md
#        AT RUN TIME on every invocation, never from a stored copy, so the
#        bijection verifies the spec, not a list. Tests bind by name via the
#        Zig registry convention (SPEC.md section 11.1, "an equivalent
#        registry in Zig"): test blocks named  test "BE_<CLASS>_<NN> ...".
#        Verdict is a HIGH-WATER RATCHET, same shape as BE-CHAN-02's
#        grow-only set: tools/m1-high-water stores the highest bound-test
#        count ever reached. FAIL if the current bound count drops below
#        high water (a test was deleted or unbound) or if orphan tests
#        appear; PASS otherwise, always printing bound/declared. The signal
#        is the number, printed every run, not the colour of the gate.
#        Local runs raise the file when the count climbs; commit the bump
#        together with the tests. CI runs never write the file.
#   M2: Mutation testing receipt (SPEC.md section 11.2). The full mutation
#        suite is expensive (~50 min for all domains), so it runs offline
#        and writes tools/m2-mutation-receipt. The gate verifies: receipt
#        exists, survived = 0, and no source drift since the receipt SHA.
#        A stale receipt (src/ or mutation-test.py changed) is PENDING; a
#        receipt with survivors is FAIL.
#   M3: The committed test/vectors.json is canonical only if it cross-verifies
#        between two independent implementations. This gate regenerates the file
#        from the Zig generator (tools/gen-vectors.zig), fails on any drift
#        versus the committed copy, then runs the independent Python verifier
#        (tools/verify-vectors.py: Ed25519/BLAKE2s/X25519) and the field-by-field
#        byte-layout walker (tools/verify-layout.py). PENDING only when python3
#        with cryptography is unavailable.
#   M4: BE-SURF-04 differential fuzzing is a MERGE GATE, not a milestone
#        (CONTRIBUTING.md line 43), so it runs on every invocation rather
#        than on a schedule. The gate drives tools/fuzz_diff.py over a
#        bounded corpus: the Zig harness emits a deterministic corpus, the
#        production parsers replay it, tools/refparse.py (an independent
#        Python parser written from the SPEC field tables alone, D-056)
#        replays the SAME file, and the two verdict streams are compared
#        record by record. Requirement is ZERO divergences: a divergence is
#        a parser defect, and an infrastructure failure (build error, broken
#        framing, stream desync) fails the gate too rather than passing
#        quietly. The row prints the record count, the divergence count, the
#        coverage reached over the exit-point denominator, and the corpus
#        description, so the SPEC section 11.6 receipt is visible on every
#        run instead of living in a log nobody opens. The budget is bounded
#        (M4_BUDGET, default 20000 records) to keep prumo fast; the full
#        long-budget run is a separate campaign, not this gate. PENDING only
#        when python3 is unavailable; a PASS without the reference parser
#        would be a false green, so it never happens.
#   M5/M11: BE-SURF-03 splits the surface into two capped units at the
#        authentication line. Both gates parse the four normative file lists,
#        each unit's cap, and the sub-unit caps from SPEC.md BE-SURF-03 at
#        run time (denominator law), and sum the listed files from the source
#        tree; absent listed files count as 0 lines. M5 gates the
#        pre-authentication unit (handshake + relay sub-units) and also
#        enforces the exhaustiveness clause (every non-test src file in
#        exactly one list, no file in two); M11 gates the post-authentication
#        unit (wire-parser + session-state + sync sub-units per D-054) and
#        fails while placement is broken.
#   M6: Offline build: the gate is "build succeeds with the network
#        disabled". Isolation is tried in order: unshare -rn, then sudo
#        ip netns (runner-friendly, build runs as the invoking user).
#        With isolation, the build runs under it and the verdict is
#        PASS/FAIL. Without isolation (macOS, locked-down runners) the
#        verdict is PENDING with what was tried; the plain build still
#        runs but its result is informational only, excluded from the
#        exit code. A PASS without isolation would be a false green,
#        so it never happens.
#   M7: build.zig hardcodes ReleaseSafe and exposes no optimize option
#        (LANGUAGE.md O1). Compiler version and flags are recorded above.
#   M9: coverage denominator law: every error exit of the parser module
#        (src/parser.zig, src/relay.zig, and src/parser/; the module straddles the
#        authentication line and is not one of the M5/M11 unit lists)
#        routes through coverage.reject(), every accepted return through
#        coverage.accept() (both wrappers in src/coverage.zig); zero raw
#        error returns remain, no exceptions. The exit-point denominator is
#        counted from the module's wrapper call sites at run time, and the
#        Branch enum in coverage.zig must match the source one for one: a
#        new exit fails the gate until the enum grows, a dead enum member
#        fails it the other way (CONTRIBUTING.md M9).
#
# Exit code: number of failing ENFORCED gates (M1, M2, M3, M4, M5, M6, M7, M8, M9,
# M10, M11).
# Usage: run from anywhere; ZIG=/path/to/zig overrides PATH lookup,
#        M4_BUDGET=N sets the differential corpus size (default 20000).

set -u

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT" || exit 2

ZIG="${ZIG:-zig}"
if ! command -v "$ZIG" >/dev/null 2>&1; then
    echo "prumo-verify: zig not found; set ZIG=/path/to/zig or add it to PATH" >&2
    exit 2
fi
ZIG_VERSION="$("$ZIG" version 2>&1)"
FAILS=0

row() { # id status detail
    printf '%-4s %-8s %s\n' "$1" "$2" "$3"
}

echo "prumo-verify: Bolina mechanical gates (CONTRIBUTING.md section 2)"
echo "repo: $REPO_ROOT"
echo "zig:  $ZIG_VERSION ($(command -v "$ZIG"))"
echo "date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo

# ---- M1: BE <-> test bijection ratchet, derived from SPEC.md at run time ----
HIGH_WATER_FILE="tools/m1-high-water"
HIGH_WATER="$(cat "$HIGH_WATER_FILE" 2>/dev/null | tr -d '[:space:]')"
case "$HIGH_WATER" in ''|*[!0-9]*) HIGH_WATER=0 ;; esac

# Declarations are derived from SPEC.md. A marker whose own declaration
# paragraph says "SUPERSEDED BY REMOVAL" (SPEC itself voids it, kept only as
# a historical note) is excluded here, so the denominator stays SPEC-derived
# rather than a hand-edited list. See DECISION-LOG D-041.
DECL="$(grep -v 'SUPERSEDED BY REMOVAL' SPEC.md | grep -oE '^\*\*BE-[A-Z]+-[0-9]+[a-z]?' | sed 's/^\*\*//' | sort -u)"
DECL_COUNT="$(printf '%s\n' "$DECL" | grep -c '^BE-' || true)"

TESTED="$(find src test -name '*.zig' -type f -exec grep -hoE 'test "BE_[A-Z]+_[0-9]+[a-z]?' {} + 2>/dev/null | sed -e 's/^test "//' -e 'y/_/-/' | sort -u || true)"
TESTED_COUNT="$(printf '%s\n' "$TESTED" | grep -c '^BE-' || true)"

if [ "$DECL_COUNT" -eq 0 ]; then
    row M1 FAIL "derivation produced 0 declarations from SPEC.md: the declaration convention changed; fix the extractor or the spec, do not hand-edit a list"
    FAILS=$((FAILS + 1))
else
    BOUND="$(comm -12 <(printf '%s\n' "$DECL") <(printf '%s\n' "$TESTED") | grep -c '^BE-' || true)"
    MISSING="$(comm -23 <(printf '%s\n' "$DECL") <(printf '%s\n' "$TESTED") | grep -c '^BE-' || true)"
    ORPHANS="$(comm -13 <(printf '%s\n' "$DECL") <(printf '%s\n' "$TESTED") | grep -c '^BE-' || true)"
    if [ "$BOUND" -lt "$HIGH_WATER" ]; then
        row M1 FAIL "ratchet regression: $BOUND/$DECL_COUNT bound, below high water $HIGH_WATER: a bound test was deleted or unbound"
        FAILS=$((FAILS + 1))
    elif [ "$ORPHANS" -gt 0 ]; then
        row M1 FAIL "bijection open: $BOUND/$DECL_COUNT bound, orphan tests: $ORPHANS name undeclared BE items"
        FAILS=$((FAILS + 1))
    else
        row M1 PASS "ratchet: $BOUND/$DECL_COUNT bound, high water $HIGH_WATER, missing $MISSING (SPEC.md section 11.1)"
        if [ "$BOUND" -gt "$HIGH_WATER" ]; then
            if [ -n "${GITHUB_ACTIONS:-}" ]; then
                echo "     note: high water bump pending; commit tools/m1-high-water = $BOUND with these tests"
            else
                printf '%s\n' "$BOUND" > "$HIGH_WATER_FILE"
                echo "     note: high water raised to $BOUND in $HIGH_WATER_FILE; commit it with these tests"
            fi
        fi
    fi
fi

# ---- M2: mutation receipt, SPEC.md section 11.2 (ENFORCED) ----
# Receipt-based gate. The mutation suite is expensive (~50 min for all
# domains), so it runs offline and writes tools/m2-mutation-receipt.
# prumo-verify checks: (a) receipt exists, (b) survived = 0, (c) no src/
# or tools/mutation-test.py changed since the receipt SHA. A stale receipt
# (source drift) is PENDING; a receipt with survivors is FAIL. The
# equivalent=N field (D-088) counts documented-equivalent mutants, which
# the suite excludes from the kill-rate denominator; their rationale lives
# in tools/mutation-test.py (EQUIVALENT set), so any change to that set is
# source drift and invalidates the receipt.
M2_RECEIPT="tools/m2-mutation-receipt"
m2_verdict="PASS"
m2_detail=""
if [ ! -f "$M2_RECEIPT" ]; then
    m2_verdict="PENDING"
    m2_detail="no mutation receipt: run the full mutation suite and commit tools/m2-mutation-receipt (SPEC.md section 11.2)"
else
    m2_sha="$(grep '^sha=' "$M2_RECEIPT" | head -1 | sed 's/^sha=//')"
    m2_total_line="$(grep '^total=' "$M2_RECEIPT" | head -1)"
    m2_survived="$(printf '%s\n' "$m2_total_line" | grep -o 'survived=[0-9]*' | sed 's/survived=//')"
    m2_equiv="$(printf '%s\n' "$m2_total_line" | grep -o 'equivalent=[0-9]*' | sed 's/equivalent=//')"
    m2_killed="$(printf '%s\n' "$m2_total_line" | sed 's/total=\([0-9]*\)\/.*/\1/')"
    m2_denom="$(printf '%s\n' "$m2_total_line" | sed 's/total=[0-9]*\/\([0-9]*\).*/\1/')"
    if [ -z "$m2_sha" ] || [ -z "$m2_total_line" ]; then
        m2_verdict="FAIL"
        m2_detail="mutation receipt malformed (missing sha= or total= line)"
    elif ! git cat-file -e "$m2_sha" 2>/dev/null; then
        m2_verdict="FAIL"
        m2_detail="mutation receipt SHA $m2_sha not found in git history"
    else
        # Check if source drifted since receipt
        m2_drift="$(git diff --stat "$m2_sha" HEAD -- src/ tools/mutation-test.py 2>/dev/null)"
        if [ -n "$m2_drift" ]; then
            m2_verdict="PENDING"
            m2_detail="mutation receipt stale: src/ or mutation-test.py changed since $m2_sha; re-run the suite (SPEC.md section 11.2)"
        elif [ "${m2_survived:-0}" -ne 0 ]; then
            m2_verdict="FAIL"
            m2_detail="$m2_survived survivor(s) in $m2_denom mutants (receipt at $m2_sha)"
        else
            m2_detail="$m2_killed/$m2_denom non-equivalent mutants killed, 0 survived, ${m2_equiv:-0} documented equivalent (receipt at $m2_sha, SPEC.md section 11.2)"
        fi
    fi
fi
row M2 "$m2_verdict" "$m2_detail"
if [ "$m2_verdict" = "FAIL" ]; then
    FAILS=$((FAILS + 1))
fi

# ---- M3: cross-implementation vectors, SPEC.md section 11.3 (ENFORCED) ----
# The committed test/vectors.json is canonical only if two independent
# implementations agree on it. This gate: (a) regenerates the file from the Zig
# generator, (b) fails on any drift versus the committed copy, (c) runs the
# independent Python cross-verifier (Ed25519/BLAKE2s/X25519) and the field-by-field
# byte-layout walker. PENDING only when python3 + cryptography are unavailable.
m3_verdict="PASS"
m3_detail=""
if [ ! -f test/vectors.json ]; then
    m3_verdict="FAIL"; m3_detail="test/vectors.json missing: run 'zig run tools/gen-vectors.zig' and commit it"
elif ! python3 -c "import json; json.load(open('test/vectors.json'))" 2>/dev/null; then
    m3_verdict="FAIL"; m3_detail="test/vectors.json is not valid JSON"
elif ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import cryptography" 2>/dev/null; then
    m3_verdict="PENDING"; m3_detail="python3 with cryptography unavailable: cannot cross-verify (SPEC.md section 11.3)"
else
    regen_out="$("$ZIG" run tools/gen-vectors.zig 2>&1)"
    if [ $? -ne 0 ]; then
        m3_verdict="FAIL"; m3_detail="vector generator failed: $(printf '%s' "$regen_out" | tail -1)"
    elif git rev-parse --verify HEAD >/dev/null 2>&1 && git ls-files --error-unmatch test/vectors.json >/dev/null 2>&1; then
        # tracked file: regenerated output must be byte-identical to the committed copy
        if [ -n "$(git diff --no-color --text HEAD -- test/vectors.json)" ]; then
            m3_verdict="FAIL"; m3_detail="committed test/vectors.json drifted from generator output: regenerate and commit"
        fi
    fi
    if [ "$m3_verdict" = "PASS" ]; then
        v_out="$(python3 tools/verify-vectors.py 2>&1)"; v_rc=$?
        l_out="$(python3 tools/verify-layout.py 2>&1)"; l_rc=$?
        if [ "$v_rc" -ne 0 ]; then
            m3_verdict="FAIL"; m3_detail="independent cross-verify failed: $(printf '%s' "$v_out" | grep -i fail | tail -1)"
        elif [ "$l_rc" -ne 0 ]; then
            m3_verdict="FAIL"; m3_detail="byte-layout verify failed: $(printf '%s' "$l_out" | grep -i fail | tail -1)"
        else
            m3_detail="vectors cross-verify (zig <-> python cryptography) + byte-layout walk both green (SPEC.md section 11.3)"
        fi
    fi
fi
row M3 "$m3_verdict" "$m3_detail"
if [ "$m3_verdict" = "FAIL" ]; then
    FAILS=$((FAILS + 1))
fi

# ---- M4: differential fuzz oracle, SPEC.md section 11.6 / BE-SURF-04 (ENFORCED) ----
# A merge gate, so it runs every time. tools/fuzz_diff.py emits a bounded
# deterministic corpus, replays it through the production parsers AND through
# the independent Python reference (tools/refparse.py), and compares the two
# verdict streams record by record. Zero divergences required. The receipt
# (records, divergences, coverage over the exit-point denominator, corpus
# description) is parsed back out of the orchestrator's own output and printed
# on the row: the numbers come from the run, never from this script.
M4_BUDGET="${M4_BUDGET:-20000}"
m4_verdict="PASS"
m4_detail=""
if ! command -v python3 >/dev/null 2>&1; then
    m4_verdict="PENDING"; m4_detail="python3 unavailable: the independent reference parser cannot run, and a PASS without it would be a false green (SPEC.md section 11.6)"
elif [ ! -f tools/fuzz_diff.py ] || [ ! -f tools/refparse.py ]; then
    m4_verdict="FAIL"; m4_detail="differential oracle missing: tools/fuzz_diff.py and tools/refparse.py ARE the gate (BE-SURF-04, D-056)"
else
    m4_out="$(python3 tools/fuzz_diff.py --budget "$M4_BUDGET" --zig "$ZIG" 2>&1)"
    m4_rc=$?
    # Parse the receipt block only, so the early "corpus: <path>" progress line
    # cannot be mistaken for the receipt's corpus description.
    m4_receipt="$(printf '%s\n' "$m4_out" | sed -n '/^== receipt ==$/,$p')"
    m4_records="$(printf '%s\n' "$m4_receipt" | sed -n 's/^records: \([0-9][0-9]*\).*/\1/p')"
    m4_div="$(printf '%s\n' "$m4_receipt" | sed -n 's/^divergences: \([0-9][0-9]*\)$/\1/p')"
    m4_cov="$(printf '%s\n' "$m4_receipt" | sed -n 's/^coverage: \(.*\)$/\1/p')"
    m4_corpus="$(printf '%s\n' "$m4_receipt" | sed -n 's/^corpus: \(.*\)$/\1/p')"
    if [ "$m4_rc" -eq 1 ]; then
        m4_verdict="FAIL"
        m4_detail="${m4_div:-unknown} divergence(s) over $m4_records records: the production parser and the independent reference disagree, saved under .fuzz-diff/divergences (BE-SURF-04)"
    elif [ "$m4_rc" -ne 0 ]; then
        m4_verdict="FAIL"
        m4_detail="differential oracle infrastructure failure (rc=$m4_rc): $(printf '%s' "$m4_out" | grep -E '^FAIL:' | tail -1) (BE-SURF-04)"
    elif [ -z "$m4_div" ] || [ -z "$m4_records" ]; then
        m4_verdict="FAIL"
        m4_detail="differential oracle receipt not parsed: the orchestrator's output shape changed, fix the extractor rather than trusting a green (BE-SURF-04)"
    elif [ "$m4_div" -ne 0 ]; then
        m4_verdict="FAIL"
        m4_detail="$m4_div divergence(s) over $m4_records records despite rc=0: orchestrator and gate disagree (BE-SURF-04)"
    elif [ -z "$m4_cov" ] || [ "${m4_cov#NOT REPORTED}" != "$m4_cov" ]; then
        m4_verdict="FAIL"
        m4_detail="coverage not reported by the differential run: the SPEC section 11.6 receipt is incomplete, so the run is not evidence (BE-SURF-04)"
    else
        m4_detail="0 divergences over $m4_records records; coverage $m4_cov; corpus $m4_corpus (SPEC.md section 11.6, BE-SURF-04, D-056)"
    fi
fi
row M4 "$m4_verdict" "$m4_detail"
if [ "$m4_verdict" = "FAIL" ]; then
    FAILS=$((FAILS + 1))
fi

# ---- M5/M11: BE-SURF-03 surface units, denominators parsed from SPEC.md ----
# Both gates read the four normative file lists and the line cap from the
# BE-SURF-03 text at run time (denominator law): nothing about the units is
# stored in this script. M5 gates the pre-authentication unit (subdivided into
# handshake ≤990 and relay ≤510 sub-units, sum ≤1500) and enforces the
# exhaustiveness clause (every non-test src file in exactly one list, no
# file in two); M11 gates the post-authentication unit (subdivided into
# wire-parser ≤723 and session-state ≤777 sub-units, sum ≤1500). Absent listed
# files
# count as 0 lines: the lists are normative placement, ahead of the code.
SURF_SECTION="$(sed -n '/\*\*BE-SURF-03/,/no unmeasured place/p' SPEC.md)"
SURF_JOINED="$(printf '%s\n' "$SURF_SECTION" | awk '
    /^- \*\*/ { if (b != "") print b; b = $0; next }
    /^  / && b != "" { line = $0; sub(/^ +/, " ", line); b = b line; next }
    { if (b != "") { print b; b = "" } }
    END { if (b != "") print b }')"
surf_bullet_files() { # label -> one file path per line (from joined bullets)
    printf '%s\n' "$SURF_JOINED" | grep -F "$1" | grep -o 'src/[a-z0-9_/]*\.zig' | sort
}
surf_sub_bullet_files() { # label -> files from the raw line containing that label (sub-bullets)
    printf '%s\n' "$SURF_SECTION" | grep -F "$1" | grep -o 'src/[a-z0-9_/]*\.zig' | sort
}
surf_sub_bullet_cap() { # label -> cap number from "cap N lines" on the raw line
    printf '%s\n' "$SURF_SECTION" | grep -F "$1" | grep -o 'cap [0-9][0-9]* lines' | grep -o '[0-9][0-9]*'
}
PRE_AUTH_FILES="$(surf_bullet_files '**Pre-authentication unit:**')"
HANDSHAKE_FILES="$(surf_sub_bullet_files '**Handshake sub-unit:**')"
RELAY_FILES="$(surf_sub_bullet_files '**Relay sub-unit:**')"
LISTENER_FILES="$(surf_sub_bullet_files '**Listener sub-unit:**')"
HANDSHAKE_CAP="$(surf_sub_bullet_cap '**Handshake sub-unit:**')"
RELAY_CAP="$(surf_sub_bullet_cap '**Relay sub-unit:**')"
LISTENER_CAP="$(surf_sub_bullet_cap '**Listener sub-unit:**')"
WIREPARSER_FILES="$(surf_sub_bullet_files '**Wire-parser sub-unit:**')"
SESSIONSTATE_FILES="$(surf_sub_bullet_files '**Session-state sub-unit:**')"
SYNC_FILES="$(surf_sub_bullet_files '**Sync sub-unit:**')"
WIREPARSER_CAP="$(surf_sub_bullet_cap '**Wire-parser sub-unit:**')"
SESSIONSTATE_CAP="$(surf_sub_bullet_cap '**Session-state sub-unit:**')"
SYNC_CAP="$(surf_sub_bullet_cap '**Sync sub-unit:**')"
POST_AUTH_FILES="$(surf_bullet_files '**Post-authentication unit:**')"
NON_SURFACE_FILES="$(surf_bullet_files '**Non-surface:**')"
HARNESS_FILES="$(surf_bullet_files '**Harness and entry:**')"
HARNESS_TEST_GLOB=0
printf '%s\n' "$SURF_JOINED" | grep -F '**Harness and entry:**' | grep -q '\*_test\.zig' && HARNESS_TEST_GLOB=1
SURF_FLAT="$(printf '%s\n' "$SURF_SECTION" | tr '\n' ' ')"
UNIT_CAP="$(printf '%s\n' "$SURF_FLAT" | grep -o 'MUST NOT exceed \*\*[0-9][0-9]* lines\*\*' | head -1 | grep -o '[0-9][0-9]*')"
PRE_AUTH_CAP="$(printf '%s\n' "$SURF_FLAT" | grep -o 'the sum MUST NOT exceed [0-9][0-9]* lines' | sed -n '1p' | grep -o '[0-9][0-9]*')"
POST_AUTH_CAP="$(printf '%s\n' "$SURF_FLAT" | grep -o 'the sum MUST NOT exceed [0-9][0-9]* lines' | sed -n '2p' | grep -o '[0-9][0-9]*')"

SURF_PROBLEMS=""
[ -z "$UNIT_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS unit line cap not parsed from SPEC.md BE-SURF-03;"
[ -z "$PRE_AUTH_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS pre-authentication cap-sum sentence not parsed from SPEC.md BE-SURF-03;"
[ -z "$POST_AUTH_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS post-authentication cap-sum sentence not parsed from SPEC.md BE-SURF-03;"
[ -n "$PRE_AUTH_CAP" ] && [ -n "$UNIT_CAP" ] && [ "$PRE_AUTH_CAP" -gt "$UNIT_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS pre-authentication cap ($PRE_AUTH_CAP) exceeds unit cap ($UNIT_CAP);"
[ -n "$POST_AUTH_CAP" ] && [ -n "$UNIT_CAP" ] && [ "$POST_AUTH_CAP" -gt "$UNIT_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS post-authentication cap ($POST_AUTH_CAP) exceeds unit cap ($UNIT_CAP);"
[ -z "$PRE_AUTH_FILES" ] && SURF_PROBLEMS="$SURF_PROBLEMS pre-authentication list not parsed from SPEC.md BE-SURF-03;"
[ -z "$POST_AUTH_FILES" ] && SURF_PROBLEMS="$SURF_PROBLEMS post-authentication list not parsed from SPEC.md BE-SURF-03;"
[ "$HARNESS_TEST_GLOB" -eq 0 ] && SURF_PROBLEMS="$SURF_PROBLEMS harness *_test.zig glob not found in SPEC.md BE-SURF-03;"
[ -z "$HANDSHAKE_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS handshake sub-unit cap not parsed from SPEC.md BE-SURF-03;"
[ -z "$RELAY_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS relay sub-unit cap not parsed from SPEC.md BE-SURF-03;"
[ -z "$LISTENER_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS listener sub-unit cap not parsed from SPEC.md BE-SURF-03;"
[ -z "$WIREPARSER_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS wire-parser sub-unit cap not parsed from SPEC.md BE-SURF-03;"
[ -z "$SESSIONSTATE_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS session-state sub-unit cap not parsed from SPEC.md BE-SURF-03;"
[ -z "$SYNC_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS sync sub-unit cap not parsed from SPEC.md BE-SURF-03;"
[ -n "$HANDSHAKE_CAP" ] && [ -n "$RELAY_CAP" ] && [ -n "$LISTENER_CAP" ] && [ -n "$PRE_AUTH_CAP" ] && [ "$((HANDSHAKE_CAP + RELAY_CAP + LISTENER_CAP))" -gt "$PRE_AUTH_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS handshake cap ($HANDSHAKE_CAP) + relay cap ($RELAY_CAP) + listener cap ($LISTENER_CAP) exceeds pre-authentication cap ($PRE_AUTH_CAP);"
[ -n "$WIREPARSER_CAP" ] && [ -n "$SESSIONSTATE_CAP" ] && [ -n "$SYNC_CAP" ] && [ -n "$POST_AUTH_CAP" ] && [ "$((WIREPARSER_CAP + SESSIONSTATE_CAP + SYNC_CAP))" -gt "$POST_AUTH_CAP" ] && SURF_PROBLEMS="$SURF_PROBLEMS wire-parser cap ($WIREPARSER_CAP) + session-state cap ($SESSIONSTATE_CAP) + sync cap ($SYNC_CAP) exceeds post-authentication cap ($POST_AUTH_CAP);"
SURF_DUPES="$(printf '%s\n%s\n%s\n%s\n' "$PRE_AUTH_FILES" "$POST_AUTH_FILES" "$NON_SURFACE_FILES" "$HARNESS_FILES" | grep -v '^$' | sort | uniq -d)"
[ -n "$SURF_DUPES" ] && SURF_PROBLEMS="$SURF_PROBLEMS placed in more than one BE-SURF-03 list: $(printf '%s\n' "$SURF_DUPES" | tr '\n' ' ');"
SURF_PLACED="$(printf '%s\n%s\n%s\n%s\n' "$PRE_AUTH_FILES" "$POST_AUTH_FILES" "$NON_SURFACE_FILES" "$HARNESS_FILES" | grep -v '^$' | sort)"
SURF_UNPLACED=""
for f in $(find src -name '*.zig' -type f ! -name '*_test.zig' | sort); do
    printf '%s\n' "$SURF_PLACED" | grep -qx "$f" || SURF_UNPLACED="$SURF_UNPLACED $f"
done
[ -n "$SURF_UNPLACED" ] && SURF_PROBLEMS="$SURF_PROBLEMS not placed by SPEC.md BE-SURF-03:$SURF_UNPLACED;"

surf_unit_lines() { # newline-separated file list -> total lines, absent = 0
    local total=0 f
    for f in $1; do
        if [ -f "$f" ]; then total=$((total + $(wc -l < "$f"))); fi
    done
    echo "$total"
}
surf_unit_detail() { # newline-separated file list -> "name N," per file
    local out="" f n
    for f in $1; do
        if [ -f "$f" ]; then
            n="$(wc -l < "$f" | tr -d ' ')"
            out="$out ${f#src/} $n,"
        else
            out="$out ${f#src/} absent,"
        fi
    done
    echo "$out"
}
PRE_AUTH_LINES="$(surf_unit_lines "$PRE_AUTH_FILES")"
HANDSHAKE_LINES="$(surf_unit_lines "$HANDSHAKE_FILES")"
RELAY_LINES="$(surf_unit_lines "$RELAY_FILES")"
LISTENER_LINES="$(surf_unit_lines "$LISTENER_FILES")"
POST_AUTH_LINES="$(surf_unit_lines "$POST_AUTH_FILES")"
WIREPARSER_LINES="$(surf_unit_lines "$WIREPARSER_FILES")"
SESSIONSTATE_LINES="$(surf_unit_lines "$SESSIONSTATE_FILES")"
SYNC_LINES="$(surf_unit_lines "$SYNC_FILES")"

if [ -n "$SURF_PROBLEMS" ]; then
    row M5 FAIL "${SURF_PROBLEMS# } (BE-SURF-03)"
    FAILS=$((FAILS + 1))
elif [ "$HANDSHAKE_LINES" -le "$HANDSHAKE_CAP" ] && [ "$RELAY_LINES" -le "$RELAY_CAP" ] && [ "$LISTENER_LINES" -le "$LISTENER_CAP" ] && [ "$PRE_AUTH_LINES" -le "$PRE_AUTH_CAP" ]; then
    row M5 PASS "pre-authentication unit $PRE_AUTH_LINES/$PRE_AUTH_CAP lines (handshake $HANDSHAKE_LINES/$HANDSHAKE_CAP, relay $RELAY_LINES/$RELAY_CAP, listener $LISTENER_LINES/$LISTENER_CAP):$(surf_unit_detail "$PRE_AUTH_FILES") lists and caps parsed from SPEC.md BE-SURF-03"
else
    DETAIL=""
    [ "$HANDSHAKE_LINES" -gt "$HANDSHAKE_CAP" ] && DETAIL="$DETAIL handshake sub-unit $HANDSHAKE_LINES/$HANDSHAKE_CAP over budget;"
    [ "$RELAY_LINES" -gt "$RELAY_CAP" ] && DETAIL="$DETAIL relay sub-unit $RELAY_LINES/$RELAY_CAP over budget;"
    [ "$LISTENER_LINES" -gt "$LISTENER_CAP" ] && DETAIL="$DETAIL listener sub-unit $LISTENER_LINES/$LISTENER_CAP over budget;"
    [ "$PRE_AUTH_LINES" -gt "$PRE_AUTH_CAP" ] && DETAIL="$DETAIL total $PRE_AUTH_LINES/$PRE_AUTH_CAP over budget;"
    row M5 FAIL "pre-authentication unit ${DETAIL# }:$(surf_unit_detail "$PRE_AUTH_FILES") (BE-SURF-03)"
    FAILS=$((FAILS + 1))
fi
if [ -n "$SURF_PROBLEMS" ]; then
    M11_VERDICT="FAIL"
    M11_DETAIL="BE-SURF-03 placement broken, post-authentication sum not trustworthy (see M5)"
elif [ "$POST_AUTH_LINES" -le "$POST_AUTH_CAP" ] && [ "$WIREPARSER_LINES" -le "$WIREPARSER_CAP" ] && [ "$SESSIONSTATE_LINES" -le "$SESSIONSTATE_CAP" ] && [ "$SYNC_LINES" -le "$SYNC_CAP" ]; then
    M11_VERDICT="PASS"
    M11_DETAIL="post-authentication unit $POST_AUTH_LINES/$POST_AUTH_CAP lines (wire-parser $WIREPARSER_LINES/$WIREPARSER_CAP, session-state $SESSIONSTATE_LINES/$SESSIONSTATE_CAP, sync $SYNC_LINES/$SYNC_CAP):$(surf_unit_detail "$POST_AUTH_FILES") lists and caps parsed from SPEC.md BE-SURF-03"
else
    DETAIL=""
    [ "$WIREPARSER_LINES" -gt "$WIREPARSER_CAP" ] && DETAIL="$DETAIL wire-parser sub-unit $WIREPARSER_LINES/$WIREPARSER_CAP over budget;"
    [ "$SESSIONSTATE_LINES" -gt "$SESSIONSTATE_CAP" ] && DETAIL="$DETAIL session-state sub-unit $SESSIONSTATE_LINES/$SESSIONSTATE_CAP over budget;"
    [ "$SYNC_LINES" -gt "$SYNC_CAP" ] && DETAIL="$DETAIL sync sub-unit $SYNC_LINES/$SYNC_CAP over budget;"
    [ "$POST_AUTH_LINES" -gt "$POST_AUTH_CAP" ] && DETAIL="$DETAIL total $POST_AUTH_LINES/$POST_AUTH_CAP over budget;"
    M11_VERDICT="FAIL"
    M11_DETAIL="post-authentication unit ${DETAIL# }:$(surf_unit_detail "$POST_AUTH_FILES") (BE-SURF-03)"
fi

# ---- M6: build with the network disabled, no package manager ----
DEP_NOTE="dependency table empty"
if ! grep -q '\.dependencies = \.{},' build.zig.zon; then
    DEP_NOTE="WARNING: build.zig.zon dependencies table is not empty"
fi
OS="$(uname -s)"
ZIG_BIN="$(command -v "$ZIG")"
ISO=""
TRIED=""
if [ "$OS" = "Linux" ]; then
    TRIED="tried unshare -rn, then sudo ip netns"
    if unshare -rn true 2>/dev/null; then
        ISO="a network namespace (unshare -rn)"
        BUILD_OUT="$(unshare -rn "$ZIG_BIN" build 2>&1)"
        BUILD_RC=$?
    elif [ "$(id -u)" -ne 0 ] && sudo -n true 2>/dev/null && sudo -n ip netns add bolina-m6 2>/dev/null; then
        ISO="a network namespace (sudo ip netns)"
        BUILD_OUT="$(sudo -n ip netns exec bolina-m6 sudo -n -u "$(id -un)" env HOME="$HOME" "$ZIG_BIN" build 2>&1)"
        BUILD_RC=$?
        sudo -n ip netns del bolina-m6 2>/dev/null || true
    fi
else
    TRIED="no network namespace facility on $OS"
fi
if [ -z "$ISO" ]; then
    BUILD_OUT="$("$ZIG_BIN" build 2>&1)"
    BUILD_RC=$?
fi
if [ -n "$ISO" ] && [ "$BUILD_RC" -eq 0 ]; then
    row M6 PASS "build OK with network disabled via $ISO; $DEP_NOTE (SPEC.md section 11.7, BE-DEP-01)"
elif [ -n "$ISO" ]; then
    row M6 FAIL "build failed with network disabled via $ISO; $DEP_NOTE: $(printf '%s' "$BUILD_OUT" | tail -1)"
    FAILS=$((FAILS + 1))
else
    row M6 PENDING "offline build not verified: $TRIED; plain build rc=$BUILD_RC is informational only, excluded from the exit code; $DEP_NOTE (SPEC.md section 11.7, BE-DEP-01)"
fi

# ---- M7: shipped build is ReleaseSafe, version and flags recorded ----
M7_PROBLEMS=""
if grep -q 'standardOptimizeOption(' build.zig; then
    M7_PROBLEMS="$M7_PROBLEMS optimize mode exposed via standardOptimizeOption;"
fi
if ! grep -q 'ReleaseSafe' build.zig; then
    M7_PROBLEMS="$M7_PROBLEMS ReleaseSafe not hardcoded in build.zig;"
fi
if "$ZIG" build --help 2>&1 | grep -q '\-Doptimize'; then
    M7_PROBLEMS="$M7_PROBLEMS -Doptimize flag reachable;"
fi
if [ -z "$M7_PROBLEMS" ]; then
    row M7 PASS "ReleaseSafe hardcoded, no optimize flag exposed; zig $ZIG_VERSION (LANGUAGE.md O1, SPEC.md section 11.8)"
else
    row M7 FAIL "$M7_PROBLEMS (LANGUAGE.md O1, SPEC.md section 11.8)"
    FAILS=$((FAILS + 1))
fi

# ---- M8: zero pointer-minting builtins (BE-GRANT-03b, round 4 restatement) ----
# The storable capability is deleted: verification is a call, not a value. No
# opaque type, no boundary casts, no negative compile canary remain. The
# pointer-minting builtin set is {@ptrCast, @ptrFromInt} (Zig language reference:
# @ptrCast reinterprets an existing pointer's type, @ptrFromInt mints a pointer
# from a raw address). @bitCast is excluded because the compiler refuses a
# bit-cast whose target is a pointer type ("cannot @bitCast to ...; use
# @ptrFromInt"), confirmed by compile probe. The count MUST be zero across the
# whole src/ tree: no code mints or reinterprets a pointer to a capability value
# that no longer exists. BE-GRANT-03b's round 4 restatement removed the two
# boundary functions, so the denominator (count 0) traces to "no value
# representing a verified grant exists outside the call." Comments are stripped
# before counting so prose cannot mask a cast.
FORGE_PATTERN='@ptrCast|@ptrFromInt'
FORGE_HITS="$(grep -rnE "$FORGE_PATTERN" src/ 2>/dev/null | sed 's|//.*||' | grep -E "$FORGE_PATTERN" || true)"
FORGE_COUNT="$(printf '%s\n' "$FORGE_HITS" | grep -cE "$FORGE_PATTERN" || true)"
M8_PROBLEMS=""
if [ -n "$FORGE_HITS" ]; then
    printf '%s\n' "$FORGE_HITS" | while IFS= read -r hit; do
        echo "     pointer-mint builtin at $hit"
    done
    M8_PROBLEMS="$M8_PROBLEMS expected 0 pointer-minting builtins (@ptrCast|@ptrFromInt), found $FORGE_COUNT;"
fi
if [ -z "$M8_PROBLEMS" ]; then
    row M8 PASS "0 pointer-minting builtins (@ptrCast|@ptrFromInt) in src/; no capability type to forge (BE-GRANT-03b, SPEC.md section 8.2)"
else
    row M8 FAIL "${M8_PROBLEMS# } (BE-GRANT-03b, SPEC.md section 8.2)"
    FAILS=$((FAILS + 1))
fi

# ---- M9: coverage denominator derived from the parser module, zero raw error returns ----
# Every parser error exit routes through coverage.reject() and every accepted
# return through coverage.accept(); both wrappers live in src/coverage.zig.
# The denominator is counted HERE from the parser module's wrapper call sites
# at run time (src/parser.zig, src/relay.zig, plus src/parser/; the module straddles the
# authentication line and is not one of the M5/M11 unit lists), never taken
# from the enum alone: the Branch enum must match the
# source one for one (one counter per exit site), a new exit point fails
# until the enum grows, and a dead enum member fails the other way. Comments
# are stripped before every count so prose cannot mask an exit. Zero
# exceptions: one exception is the start of a list, and a list is where M8
# once hid a gap.
M9_STRIP='s|//.*||'
PARSER_MODULE_FILES="src/parser.zig src/relay.zig $(find src/parser -name '*.zig' -type f 2>/dev/null | sort | tr '\n' ' ')"
RAW_RET="$(cat $PARSER_MODULE_FILES | sed "$M9_STRIP" | grep -c 'return error\.' || true)"
REJECT_TAGS="$(cat $PARSER_MODULE_FILES | sed "$M9_STRIP" | grep -o 'coverage\.reject(\.[a-z_0-9]*' | sed 's/.*\.//' | sort)"
ACCEPT_TAGS="$(cat $PARSER_MODULE_FILES | sed "$M9_STRIP" | grep -o 'coverage\.accept(\.[a-z_0-9]*' | sed 's/.*\.//' | sort)"
REJECT_COUNT="$(printf '%s\n' "$REJECT_TAGS" | grep -c '[a-z_]' || true)"
ACCEPT_COUNT="$(printf '%s\n' "$ACCEPT_TAGS" | grep -c '[a-z_]' || true)"
SITE_COUNT=$((REJECT_COUNT + ACCEPT_COUNT))
USED_TAGS="$(printf '%s\n%s\n' "$REJECT_TAGS" "$ACCEPT_TAGS" | grep '[a-z_]' | sort)"
DUPES="$(printf '%s\n' "$USED_TAGS" | uniq -d | tr '\n' ' ')"
ENUM_TAGS="$(sed -n '/pub const Branch = enum {/,/};/p' src/coverage.zig | grep -o '^[[:space:]]*[a-z_0-9]*,' | sed 's/[[:space:],]//g' | grep '[a-z_]' | sort)"
ENUM_COUNT="$(printf '%s\n' "$ENUM_TAGS" | grep -c '[a-z_]' || true)"
MISSING_IN_ENUM="$(comm -23 <(printf '%s\n' "$USED_TAGS") <(printf '%s\n' "$ENUM_TAGS") | tr '\n' ' ')"
DEAD_IN_ENUM="$(comm -13 <(printf '%s\n' "$USED_TAGS") <(printf '%s\n' "$ENUM_TAGS") | tr '\n' ' ')"
M9_PROBLEMS=""
if [ "$RAW_RET" -ne 0 ]; then
    M9_PROBLEMS="$M9_PROBLEMS $RAW_RET raw error return(s) in the parser module: every error exit routes through coverage.reject(), zero exceptions;"
fi
if [ "$SITE_COUNT" -eq 0 ]; then
    M9_PROBLEMS="$M9_PROBLEMS no wrapper call sites found in the parser module: the extractor broke or the parser moved;"
elif [ "$SITE_COUNT" -ne "$ENUM_COUNT" ]; then
    M9_PROBLEMS="$M9_PROBLEMS $SITE_COUNT wrapper call sites but $ENUM_COUNT Branch enum members: one counter per exit site, one for one;"
fi
if [ -n "$DUPES" ]; then
    M9_PROBLEMS="$M9_PROBLEMS shared counters (tags with more than one call site): $DUPES: a second call site needs its own counter so reach is not over-described;"
fi
if [ -n "$MISSING_IN_ENUM" ]; then
    M9_PROBLEMS="$M9_PROBLEMS call-site tags missing from the Branch enum: $MISSING_IN_ENUM;"
fi
if [ -n "$DEAD_IN_ENUM" ]; then
    M9_PROBLEMS="$M9_PROBLEMS dead Branch enum members with no call site: $DEAD_IN_ENUM;"
fi
if [ -z "$M9_PROBLEMS" ]; then
    row M9 PASS "coverage denominator: $SITE_COUNT exit points derived from the parser module ($REJECT_COUNT reject + $ACCEPT_COUNT accept); Branch enum matches one for one; zero raw error returns (SPEC.md section 11.6)"
else
    row M9 FAIL "${M9_PROBLEMS# } (SPEC.md section 11.6)"
    FAILS=$((FAILS + 1))
fi

# ---- M10: call-graph wall, effect reachable only from verifyGrantThen ----
# The effect callback invocation `execute(` must appear exactly once in src/,
# inside verifyGrantThen in src/verify.zig. No other call site may invoke an
# effect function, because BE-GRANT-03b (round 4) says the effect starts inside
# the routine's frame and there is no other reach path to it. Same shape as M9:
# a zero-exceptions grep whose denominator (count 1) is derived from the source
# at run time, never taken from a stored number. Comments are stripped before
# counting so prose cannot mask a call. Daniel, round 4: "the call-graph wall is
# the only genuinely new mechanism here; if it lands later it lands never."
EFFECT_PATTERN='execute\('
EFFECT_HITS="$(grep -rnE "$EFFECT_PATTERN" src/ 2>/dev/null | sed 's|//.*||' | grep -E "$EFFECT_PATTERN" || true)"
EFFECT_COUNT="$(printf '%s\n' "$EFFECT_HITS" | grep -cE "$EFFECT_PATTERN" || true)"
M10_PROBLEMS=""
if [ -n "$EFFECT_HITS" ]; then
    printf '%s\n' "$EFFECT_HITS" | while IFS= read -r hit; do
        echo "     effect call at $hit"
    done
fi
if [ "$EFFECT_COUNT" -ne 1 ]; then
    M10_PROBLEMS="$M10_PROBLEMS expected exactly 1 effect invocation (execute( in verifyGrantThen), found $EFFECT_COUNT;"
elif printf '%s\n' "$EFFECT_HITS" | grep -vE '^src/verify\.zig:' | grep -qE "$EFFECT_PATTERN"; then
    M10_PROBLEMS="$M10_PROBLEMS an effect invocation exists outside src/verify.zig;"
fi
if [ -z "$M10_PROBLEMS" ]; then
    row M10 PASS "effect reachable only from verifyGrantThen in src/verify.zig; 1 call site, zero exceptions (BE-GRANT-03b, SPEC.md section 8.2)"
else
    row M10 FAIL "${M10_PROBLEMS# } (BE-GRANT-03b, SPEC.md section 8.2)"
    FAILS=$((FAILS + 1))
fi

row M11 "$M11_VERDICT" "$M11_DETAIL"
if [ "$M11_VERDICT" = "FAIL" ]; then
    FAILS=$((FAILS + 1))
fi

echo
echo "enforced gates: M1 M2 M3 M4 M5 M6 M7 M8 M9 M10 M11, failing: $FAILS"
exit "$FAILS"