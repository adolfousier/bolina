#!/usr/bin/env bash
# prumo-verify: Bolina mechanical gates (CONTRIBUTING.md section 2)
#
# Prints ALL NINE gates on every run. M2/M3/M4 are printed but explicitly
# marked "not yet enforced: no code to check" until the code they target
# exists. The gap is made visible instead of absent: CONTRIBUTING.md claims
# seven gates, so seven rows appear even when four have nothing to check.
#
# Conventions enforced here:
#   M1: SPEC.md declares BE-* items as paragraph-opening bold markers:
#        **BE-<CLASS>-<NN>** ... The canonical list is derived from SPEC.md
#        AT RUN TIME on every invocation, never from a stored copy, so the
#        bijection verifies the spec, not a list. Tests bind by name via the
#        Zig registry convention (SPEC.md section 11.1, "an equivalent
#        registry in Zig"): test blocks named  test "BE_<CLASS>_<NN> ...".
#        Verdict is a HIGH-WATER RATCHET, same shape as BE-CHAN-02's
#        grow-only set: tools/m1-high-water stores the highest bound-test
#        count ever reached. FAIL if the current bound count drops below
#        high water (a test was deleted or unbound) or if orphan tests
#        appear; PASS otherwise, always printing bound/declared. The signal
#        is the number, printed every run, not the colour of the gate.
#        Local runs raise the file when the count climbs; commit the bump
#        together with the tests. CI runs never write the file.
#   M3: The committed test/vectors.json is canonical only if it cross-verifies
#        between two independent implementations. This gate regenerates the file
#        from the Zig generator (tools/gen-vectors.zig), fails on any drift
#        versus the committed copy, then runs the independent Python verifier
#        (tools/verify-vectors.py: Ed25519/BLAKE2s/X25519) and the field-by-field
#        byte-layout walker (tools/verify-layout.py). PENDING only when python3
#        with cryptography is unavailable.
#   M5: The network-parsing module lives at src/parser.zig (and src/parser/
#        if it is ever split). Absent counts as 0 lines.
#   M6: Offline build: the gate is "build succeeds with the network
#        disabled". Isolation is tried in order: unshare -rn, then sudo
#        ip netns (runner-friendly, build runs as the invoking user).
#        With isolation, the build runs under it and the verdict is
#        PASS/FAIL. Without isolation (macOS, locked-down runners) the
#        verdict is PENDING with what was tried; the plain build still
#        runs but its result is informational only, excluded from the
#        exit code. A PASS without isolation would be a false green,
#        so it never happens.
#   M7: build.zig hardcodes ReleaseSafe and exposes no optimize option
#        (LANGUAGE.md O1). Compiler version and flags are recorded above.
#   M9: coverage denominator law: every error exit of src/parser.zig routes
#        through coverage.reject(), every accepted return through
#        coverage.accept() (both wrappers in src/coverage.zig); zero raw
#        error returns remain, no exceptions. The exit-point denominator is
#        counted from parser.zig wrapper call sites at run time, and the
#        Branch enum in coverage.zig must match the source one for one: a
#        new exit fails the gate until the enum grows, a dead enum member
#        fails it the other way (CONTRIBUTING.md M9).
#
# Exit code: number of failing ENFORCED gates (M1, M3, M5, M6, M7, M8, M9).
# Usage: run from anywhere; ZIG=/path/to/zig overrides PATH lookup.

set -u

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT" || exit 2

ZIG="${ZIG:-zig}"
if ! command -v "$ZIG" >/dev/null 2>&1; then
    echo "prumo-verify: zig not found; set ZIG=/path/to/zig or add it to PATH" >&2
    exit 2
fi
ZIG_VERSION="$("$ZIG" version 2>&1)"
FAILS=0

row() { # id status detail
    printf '%-4s %-8s %s\n' "$1" "$2" "$3"
}

echo "prumo-verify: Bolina mechanical gates (CONTRIBUTING.md section 2)"
echo "repo: $REPO_ROOT"
echo "zig:  $ZIG_VERSION ($(command -v "$ZIG"))"
echo "date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo

# ---- M1: BE <-> test bijection ratchet, derived from SPEC.md at run time ----
HIGH_WATER_FILE="tools/m1-high-water"
HIGH_WATER="$(cat "$HIGH_WATER_FILE" 2>/dev/null | tr -d '[:space:]')"
case "$HIGH_WATER" in ''|*[!0-9]*) HIGH_WATER=0 ;; esac

DECL="$(grep -oE '^\*\*BE-[A-Z]+-[0-9]+[a-z]?' SPEC.md | sed 's/^\*\*//' | sort -u)"
DECL_COUNT="$(printf '%s\n' "$DECL" | grep -c '^BE-' || true)"

TESTED="$(find src test -name '*.zig' -type f -exec grep -hoE 'test "BE_[A-Z]+_[0-9]+[a-z]?' {} + 2>/dev/null | sed -e 's/^test "//' -e 'y/_/-/' | sort -u || true)"
TESTED_COUNT="$(printf '%s\n' "$TESTED" | grep -c '^BE-' || true)"

if [ "$DECL_COUNT" -eq 0 ]; then
    row M1 FAIL "derivation produced 0 declarations from SPEC.md: the declaration convention changed; fix the extractor or the spec, do not hand-edit a list"
    FAILS=$((FAILS + 1))
else
    BOUND="$(comm -12 <(printf '%s\n' "$DECL") <(printf '%s\n' "$TESTED") | grep -c '^BE-' || true)"
    MISSING="$(comm -23 <(printf '%s\n' "$DECL") <(printf '%s\n' "$TESTED") | grep -c '^BE-' || true)"
    ORPHANS="$(comm -13 <(printf '%s\n' "$DECL") <(printf '%s\n' "$TESTED") | grep -c '^BE-' || true)"
    if [ "$BOUND" -lt "$HIGH_WATER" ]; then
        row M1 FAIL "ratchet regression: $BOUND/$DECL_COUNT bound, below high water $HIGH_WATER: a bound test was deleted or unbound"
        FAILS=$((FAILS + 1))
    elif [ "$ORPHANS" -gt 0 ]; then
        row M1 FAIL "bijection open: $BOUND/$DECL_COUNT bound, orphan tests: $ORPHANS name undeclared BE items"
        FAILS=$((FAILS + 1))
    else
        row M1 PASS "ratchet: $BOUND/$DECL_COUNT bound, high water $HIGH_WATER, missing $MISSING (SPEC.md section 11.1)"
        if [ "$BOUND" -gt "$HIGH_WATER" ]; then
            if [ -n "${GITHUB_ACTIONS:-}" ]; then
                echo "     note: high water bump pending; commit tools/m1-high-water = $BOUND with these tests"
            else
                printf '%s\n' "$BOUND" > "$HIGH_WATER_FILE"
                echo "     note: high water raised to $BOUND in $HIGH_WATER_FILE; commit it with these tests"
            fi
        fi
    fi
fi

# ---- M2, M4: printed, not yet enforced ----
row M2 PENDING "not yet enforced: no code to check (mutation testing, SPEC.md section 11.2)"
row M4 PENDING "not yet enforced: no code to check (differential fuzzing, SPEC.md section 11.6)"

# ---- M3: cross-implementation vectors, SPEC.md section 11.3 (ENFORCED) ----
# The committed test/vectors.json is canonical only if two independent
# implementations agree on it. This gate: (a) regenerates the file from the Zig
# generator, (b) fails on any drift versus the committed copy, (c) runs the
# independent Python cross-verifier (Ed25519/BLAKE2s/X25519) and the field-by-field
# byte-layout walker. PENDING only when python3 + cryptography are unavailable.
m3_verdict="PASS"
m3_detail=""
if [ ! -f test/vectors.json ]; then
    m3_verdict="FAIL"; m3_detail="test/vectors.json missing: run 'zig run tools/gen-vectors.zig' and commit it"
elif ! python3 -c "import json; json.load(open('test/vectors.json'))" 2>/dev/null; then
    m3_verdict="FAIL"; m3_detail="test/vectors.json is not valid JSON"
elif ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import cryptography" 2>/dev/null; then
    m3_verdict="PENDING"; m3_detail="python3 with cryptography unavailable: cannot cross-verify (SPEC.md section 11.3)"
else
    regen_out="$("$ZIG" run tools/gen-vectors.zig 2>&1)"
    if [ $? -ne 0 ]; then
        m3_verdict="FAIL"; m3_detail="vector generator failed: $(printf '%s' "$regen_out" | tail -1)"
    elif git rev-parse --verify HEAD >/dev/null 2>&1 && git ls-files --error-unmatch test/vectors.json >/dev/null 2>&1; then
        # tracked file: regenerated output must be byte-identical to the committed copy
        if [ -n "$(git diff --no-color --text HEAD -- test/vectors.json)" ]; then
            m3_verdict="FAIL"; m3_detail="committed test/vectors.json drifted from generator output: regenerate and commit"
        fi
    fi
    if [ "$m3_verdict" = "PASS" ]; then
        v_out="$(python3 tools/verify-vectors.py 2>&1)"; v_rc=$?
        l_out="$(python3 tools/verify-layout.py 2>&1)"; l_rc=$?
        if [ "$v_rc" -ne 0 ]; then
            m3_verdict="FAIL"; m3_detail="independent cross-verify failed: $(printf '%s' "$v_out" | grep -i fail | tail -1)"
        elif [ "$l_rc" -ne 0 ]; then
            m3_verdict="FAIL"; m3_detail="byte-layout verify failed: $(printf '%s' "$l_out" | grep -i fail | tail -1)"
        else
            m3_detail="vectors cross-verify (zig <-> python cryptography) + byte-layout walk both green (SPEC.md section 11.3)"
        fi
    fi
fi
row M3 "$m3_verdict" "$m3_detail"
if [ "$m3_verdict" = "FAIL" ]; then
    FAILS=$((FAILS + 1))
fi

# ---- M5: network-parsing module line budget ----
PARSER_LINES="$( { find src/parser.zig src/parser -name '*.zig' -type f 2>/dev/null || true; } | while read -r f; do wc -l < "$f"; done | awk '{ s += $1 } END { print s + 0 }')"
if [ "$PARSER_LINES" -le 1500 ]; then
    row M5 PASS "parser module $PARSER_LINES/1500 lines (BE-SURF-03)"
else
    row M5 FAIL "parser module $PARSER_LINES/1500 lines: over budget (BE-SURF-03)"
    FAILS=$((FAILS + 1))
fi

# ---- M6: build with the network disabled, no package manager ----
DEP_NOTE="dependency table empty"
if ! grep -q '\.dependencies = \.{},' build.zig.zon; then
    DEP_NOTE="WARNING: build.zig.zon dependencies table is not empty"
fi
OS="$(uname -s)"
ZIG_BIN="$(command -v "$ZIG")"
ISO=""
TRIED=""
if [ "$OS" = "Linux" ]; then
    TRIED="tried unshare -rn, then sudo ip netns"
    if unshare -rn true 2>/dev/null; then
        ISO="a network namespace (unshare -rn)"
        BUILD_OUT="$(unshare -rn "$ZIG_BIN" build 2>&1)"
        BUILD_RC=$?
    elif [ "$(id -u)" -ne 0 ] && sudo -n true 2>/dev/null && sudo -n ip netns add bolina-m6 2>/dev/null; then
        ISO="a network namespace (sudo ip netns)"
        BUILD_OUT="$(sudo -n ip netns exec bolina-m6 sudo -n -u "$(id -un)" env HOME="$HOME" "$ZIG_BIN" build 2>&1)"
        BUILD_RC=$?
        sudo -n ip netns del bolina-m6 2>/dev/null || true
    fi
else
    TRIED="no network namespace facility on $OS"
fi
if [ -z "$ISO" ]; then
    BUILD_OUT="$("$ZIG_BIN" build 2>&1)"
    BUILD_RC=$?
fi
if [ -n "$ISO" ] && [ "$BUILD_RC" -eq 0 ]; then
    row M6 PASS "build OK with network disabled via $ISO; $DEP_NOTE (SPEC.md section 11.7, BE-DEP-01)"
elif [ -n "$ISO" ]; then
    row M6 FAIL "build failed with network disabled via $ISO; $DEP_NOTE: $(printf '%s' "$BUILD_OUT" | tail -1)"
    FAILS=$((FAILS + 1))
else
    row M6 PENDING "offline build not verified: $TRIED; plain build rc=$BUILD_RC is informational only, excluded from the exit code; $DEP_NOTE (SPEC.md section 11.7, BE-DEP-01)"
fi

# ---- M7: shipped build is ReleaseSafe, version and flags recorded ----
M7_PROBLEMS=""
if grep -q 'standardOptimizeOption(' build.zig; then
    M7_PROBLEMS="$M7_PROBLEMS optimize mode exposed via standardOptimizeOption;"
fi
if ! grep -q 'ReleaseSafe' build.zig; then
    M7_PROBLEMS="$M7_PROBLEMS ReleaseSafe not hardcoded in build.zig;"
fi
if "$ZIG" build --help 2>&1 | grep -q '\-Doptimize'; then
    M7_PROBLEMS="$M7_PROBLEMS -Doptimize flag reachable;"
fi
if [ -z "$M7_PROBLEMS" ]; then
    row M7 PASS "ReleaseSafe hardcoded, no optimize flag exposed; zig $ZIG_VERSION (LANGUAGE.md O1, SPEC.md section 11.8)"
else
    row M7 FAIL "$M7_PROBLEMS (LANGUAGE.md O1, SPEC.md section 11.8)"
    FAILS=$((FAILS + 1))
fi

# ---- M8: capability forgery wall, @ptrCast confined to verify.zig + negative compile canary ----
# VerifiedGrant is an opaque type; the only construction path is @ptrCast, so every
# code-only @ptrCast must live in src/verify.zig at the two named boundary functions
# (grantOf, verifyGrant return). Comments are stripped before counting so prose cannot
# mask a cast. The negative compile canary (src/negative_capability.zig) must refuse to
# compile: the build step wraps it and expects the compiler to exit 1.
PTRCAST_HITS="$(grep -rn '@ptrCast' src/ 2>/dev/null | sed 's|//.*||' | grep '@ptrCast' || true)"
PTRCAST_COUNT="$(printf '%s\n' "$PTRCAST_HITS" | grep -c '@ptrCast' || true)"
M8_PROBLEMS=""
PTRCAST_OK="yes"
if [ -n "$PTRCAST_HITS" ]; then
    printf '%s\n' "$PTRCAST_HITS" | while IFS= read -r hit; do
        echo "     @ptrCast at $hit"
    done
    if printf '%s\n' "$PTRCAST_HITS" | grep -v '^src/verify.zig:' | grep -q '@ptrCast'; then
        PTRCAST_OK="no"
        M8_PROBLEMS="$M8_PROBLEMS a code-only @ptrCast exists outside src/verify.zig;"
    fi
fi
if [ "$PTRCAST_COUNT" -ne 2 ]; then
    PTRCAST_OK="no"
    M8_PROBLEMS="$M8_PROBLEMS expected exactly 2 code-only @ptrCast, found $PTRCAST_COUNT;"
fi
NEG_OUT="$("$ZIG" build negative 2>&1)"; NEG_RC=$?
if [ "$NEG_RC" -ne 0 ]; then
    M8_PROBLEMS="$M8_PROBLEMS negative compile canary did not refuse forgery (zig build negative rc=$NEG_RC: $(printf '%s' "$NEG_OUT" | tail -1));"
fi
if [ "$PTRCAST_OK" = "yes" ] && [ -z "$M8_PROBLEMS" ]; then
    row M8 PASS "2 code-only @ptrCast, both in src/verify.zig; negative compile canary refuses forgery (BE-GRANT-03b, SPEC.md section 8.2)"
else
    row M8 FAIL "${M8_PROBLEMS# } (BE-GRANT-03b, SPEC.md section 8.2)"
    FAILS=$((FAILS + 1))
fi

# ---- M9: coverage denominator derived from parser.zig, zero raw error returns ----
# Every parser error exit routes through coverage.reject() and every accepted
# return through coverage.accept(); both wrappers live in src/coverage.zig.
# The denominator is counted HERE from parser.zig wrapper call sites at run
# time, never taken from the enum alone: the Branch enum must match the source
# one for one (one counter per exit site), a new exit point fails until the
# enum grows, and a dead enum member fails the other way. Comments are
# stripped before every count so prose cannot mask an exit. Zero exceptions:
# one exception is the start of a list, and a list is where M8 once hid a gap.
M9_STRIP='s|//.*||'
RAW_RET="$(sed "$M9_STRIP" src/parser.zig | grep -c 'return error\.' || true)"
REJECT_TAGS="$(sed "$M9_STRIP" src/parser.zig | grep -o 'coverage\.reject(\.[a-z_0-9]*' | sed 's/.*\.//' | sort)"
ACCEPT_TAGS="$(sed "$M9_STRIP" src/parser.zig | grep -o 'coverage\.accept(\.[a-z_0-9]*' | sed 's/.*\.//' | sort)"
REJECT_COUNT="$(printf '%s\n' "$REJECT_TAGS" | grep -c '[a-z_]' || true)"
ACCEPT_COUNT="$(printf '%s\n' "$ACCEPT_TAGS" | grep -c '[a-z_]' || true)"
SITE_COUNT=$((REJECT_COUNT + ACCEPT_COUNT))
USED_TAGS="$(printf '%s\n%s\n' "$REJECT_TAGS" "$ACCEPT_TAGS" | grep '[a-z_]' | sort)"
DUPES="$(printf '%s\n' "$USED_TAGS" | uniq -d | tr '\n' ' ')"
ENUM_TAGS="$(sed -n '/pub const Branch = enum {/,/};/p' src/coverage.zig | grep -o '^[[:space:]]*[a-z_0-9]*,' | sed 's/[[:space:],]//g' | grep '[a-z_]' | sort)"
ENUM_COUNT="$(printf '%s\n' "$ENUM_TAGS" | grep -c '[a-z_]' || true)"
MISSING_IN_ENUM="$(comm -23 <(printf '%s\n' "$USED_TAGS") <(printf '%s\n' "$ENUM_TAGS") | tr '\n' ' ')"
DEAD_IN_ENUM="$(comm -13 <(printf '%s\n' "$USED_TAGS") <(printf '%s\n' "$ENUM_TAGS") | tr '\n' ' ')"
M9_PROBLEMS=""
if [ "$RAW_RET" -ne 0 ]; then
    M9_PROBLEMS="$M9_PROBLEMS $RAW_RET raw error return(s) in src/parser.zig: every error exit routes through coverage.reject(), zero exceptions;"
fi
if [ "$SITE_COUNT" -eq 0 ]; then
    M9_PROBLEMS="$M9_PROBLEMS no wrapper call sites found in src/parser.zig: the extractor broke or the parser moved;"
elif [ "$SITE_COUNT" -ne "$ENUM_COUNT" ]; then
    M9_PROBLEMS="$M9_PROBLEMS $SITE_COUNT wrapper call sites but $ENUM_COUNT Branch enum members: one counter per exit site, one for one;"
fi
if [ -n "$DUPES" ]; then
    M9_PROBLEMS="$M9_PROBLEMS shared counters (tags with more than one call site): $DUPES: a second call site needs its own counter so reach is not over-described;"
fi
if [ -n "$MISSING_IN_ENUM" ]; then
    M9_PROBLEMS="$M9_PROBLEMS call-site tags missing from the Branch enum: $MISSING_IN_ENUM;"
fi
if [ -n "$DEAD_IN_ENUM" ]; then
    M9_PROBLEMS="$M9_PROBLEMS dead Branch enum members with no call site: $DEAD_IN_ENUM;"
fi
if [ -z "$M9_PROBLEMS" ]; then
    row M9 PASS "coverage denominator: $SITE_COUNT exit points derived from src/parser.zig ($REJECT_COUNT reject + $ACCEPT_COUNT accept); Branch enum matches one for one; zero raw error returns (SPEC.md section 11.6)"
else
    row M9 FAIL "${M9_PROBLEMS# } (SPEC.md section 11.6)"
    FAILS=$((FAILS + 1))
fi

echo
echo "enforced gates: M1 M3 M5 M6 M7 M8 M9, failing: $FAILS"
echo "not yet enforced: M2 M4, printed above, excluded from the exit code"
exit "$FAILS"
